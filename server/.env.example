# Copy this file to .env and fill in your own values. Never commit .env.

PORT=5001

# Local Postgres:  postgresql://postgres:yourpassword@localhost:5432/calmconnect
# Neon / Supabase: paste the connection string they give you (it ends with ?sslmode=require)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/calmconnect

# Any long random string. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-me

# Address of the React app, for CORS
CLIENT_URL=http://localhost:5173

# AI assistant: free key from https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Admin account created by `npm run db:setup`
ADMIN_EMAIL=admin@calmconnect.local
ADMIN_PASSWORD=admin123

